# DirectCredit runtime configuration
# Copy to .env for local development. Never commit real secrets.
APP_NAME=DirectCredit
APP_ENV=development
DEBUG=false
DATABASE_URL=sqlite:///./directcredit.db

# Comma-separated browser origins. Use exact frontend URLs in staging/production.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Required in staging/production. Generate a long random value.
DIRECTCREDIT_SECRET=
ACCESS_TOKEN_HOURS=24
ALLOW_DEMO_CREDENTIAL_CLAIM=false
MAX_UPLOAD_MB=10
