{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*\\.(js|css))",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, proxy-revalidate, max-age=0" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://directcredit-api.onrender.com/api/$1" },
    { "source": "/customer", "destination": "/customer.html" },
    { "source": "/customer/", "destination": "/customer.html" },
    { "source": "/customer-login", "destination": "/customer.html" },
    { "source": "/customer-login/", "destination": "/customer.html" }
  ]
}